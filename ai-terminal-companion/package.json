{
  "name": "aiterm",
  "productName": "AI Terminal Companion",
  "desktopName": "aiterm.desktop",
  "version": "0.3.0",
  "description": "Linux terminal with a drop-down AI companion that uses an LLM on another computer",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron --ozone-platform-hint=auto .",
    "package": "node build/package.js",
    "install-app": "bash install.sh",
    "uninstall-app": "bash uninstall.sh"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.2.1"
  }
}
