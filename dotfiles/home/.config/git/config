# See https://git-scm.com/docs/git-config

[alias]
	co = checkout
	br = branch
	ci = commit
	st = status
[init]
	defaultBranch = master
[pull]
	rebase = true 			 # Rebase (instead of merge) on pull
[push]
	autoSetupRemote = true   # Automatically set upstream branch on push
[diff]
	algorithm = histogram    # Clearer diffs on moved/edited lines
	colorMoved = plain       # Highlight moved blocks in diffs
	mnemonicPrefix = true    # More intuitive refs in diff output
[commit]
	verbose = true           # Include diff comment in commit message template
[column]
	ui = auto 			     # Output in columns when possible
[branch]
	sort = -committerdate    # Sort branches by most recent commit first
[tag]
	sort = -version:refname  # Sort version numbers as you would expect
[rerere]
	enabled = true           # Record and reuse conflict resolutions
	autoupdate = true        # Apply stored conflict resolutions automatically
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[merge]
	conflictStyle = zdiff3   # Show the common ancestor in conflicts
[core]
	# Readable diffs with git-delta when it's installed, the normal pager otherwise.
	pager = "command -v delta >/dev/null && exec delta || exec less -FRX"
[interactive]
	diffFilter = "command -v delta >/dev/null && exec delta --color-only || exec cat"
[delta]
	navigate = true          # n / N jump between files
	line-numbers = true
	dark = true
	syntax-theme = ansi      # Use the terminal's colours, so diffs follow the Omarchy theme

# Name, email and credential helpers live in ~/.gitconfig, which is NOT in this repo.
# `git config --global ...` writes there too, so nothing personal lands here by accident.
